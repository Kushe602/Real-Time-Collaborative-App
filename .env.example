# Copy to .env and fill in. Sensible defaults let it run with zero config.

# Secret for signing JWT session cookies (use >=32 random bytes in production).
SECRET_KEY=change-me-to-a-long-random-secret-value-32b

# Database URL. Default is local SQLite; docker-compose overrides with Postgres.
DATABASE_URL=sqlite+aiosqlite:///./collabspace.db

# Send the session cookie only over HTTPS. Leave false for local http dev;
# set true behind TLS in production.
COOKIE_SECURE=false

# Optional Redis for multi-process WebSocket fan-out + presence. Leave unset to
# stay in-memory / single-process (zero config). Example: redis://localhost:6379/0
# REDIS_URL=

# Seconds a websocket may stay idle before the server pings it (presence).
WS_HEARTBEAT_SECONDS=25
